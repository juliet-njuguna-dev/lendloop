# ADMIN_EMAILS=you@example.com            (comma separated; these accounts become admin on first sign-in)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request
# LENDLOOP_WEBHOOK_SECRET=<long random string, same value in n8n>
